# --- 應用程式設定 ---
APP_PORT=8000

# --- PostgreSQL 設定 ---
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=shortener
DB_PORT=5432
DB_HOST=db

# --- Redis 設定 ---
REDIS_PORT=6379
REDIS_HOST=redis

# --- Ngrok 設定 (Dev 模式使用) ---
# 請到 ngrok 官網 dashboard 取得你的 Authtoken
NGROK_AUTHTOKEN=your_ngrok_auth_token_here